# Copy to .env (git-ignored). Never put a real secret in a default or in this file.
ENVIRONMENT=develop            # develop | staging | production
LOG_LEVEL=debug
HTTP_PORT=8080
CTX_TIMEOUT=15                 # per-request deadline, seconds

# Comma separated. Empty allows every origin outside production; production refuses to start without it.
CORS_ALLOWED_ORIGINS=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=dbdiagram
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
POSTGRES_SEARCH_PATH=dbdiagram,shared,public

# Apply pending migrations before serving. Off by default (replicas would race).
MIGRATE_ON_START=false

# Signs access tokens; at least 32 characters. Generate one: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=720
REGISTRATION_ENABLED=true
BCRYPT_COST=12
# register/login/refresh attempts per IP per minute
AUTH_RATE_LIMIT_PER_MIN=20
# Proxies whose X-Forwarded-For is believed (comma separated). Empty = none.
TRUSTED_PROXIES=
