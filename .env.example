# App domain (e.g. dbdiagram.udevs.io)
DOMAIN=dbdiagram.example.com

# Port to expose if not using Caddy (e.g. 80, 8080, 3000)
APP_PORT=80

# Environment: production | develop
ENVIRONMENT=production
LOG_LEVEL=info

# Allowed origins for CORS (comma separated)
CORS_ALLOWED_ORIGINS=https://dbdiagram.example.com,http://localhost:8080

# PostgreSQL credentials
POSTGRES_DATABASE=dbdiagram
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_strong_password

# JWT secret (minimum 32 characters, generate with: openssl rand -hex 32)
JWT_SECRET=generate_with_openssl_rand_hex_32_at_least_32_chars
